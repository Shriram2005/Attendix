<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ====================== SHAPE APPEARANCES ====================== -->
    
    <style name="ShapeAppearance.Attendix.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_sm</item>
    </style>

    <style name="ShapeAppearance.Attendix.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_md</item>
    </style>

    <style name="ShapeAppearance.Attendix.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_lg</item>
    </style>

    <style name="ShapeAppearance.Attendix.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

    <style name="ShapeAppearance.Attendix.CardSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/card_corner_radius_small</item>
    </style>

    <style name="ShapeAppearance.Attendix.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/bottom_sheet_corner_radius</item>
        <item name="cornerSizeTopRight">@dimen/bottom_sheet_corner_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.Attendix.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dialog_corner_radius</item>
    </style>

    <style name="ShapeAppearance.Attendix.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ====================== TEXT APPEARANCES ====================== -->
    
    <style name="TextAppearance.Attendix.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">@dimen/text_size_display_large</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="TextAppearance.Attendix.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/text_size_display_medium</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="TextAppearance.Attendix.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_size_display_small</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="TextAppearance.Attendix.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_size_headline_large</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="TextAppearance.Attendix.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_size_headline_medium</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="TextAppearance.Attendix.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_size_headline_small</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TextAppearance.Attendix.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_size_title_large</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="TextAppearance.Attendix.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_title_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TextAppearance.Attendix.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_size_title_small</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TextAppearance.Attendix.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <style name="TextAppearance.Attendix.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_body_medium</item>
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <style name="TextAppearance.Attendix.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <style name="TextAppearance.Attendix.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_size_label_large</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TextAppearance.Attendix.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_size_label_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TextAppearance.Attendix.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_size_label_small</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <!-- ====================== BUTTON STYLES ====================== -->
    
    <style name="Widget.Attendix.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendix.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
    </style>

    <style name="Widget.Attendix.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendix.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="Widget.Attendix.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendix.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Attendix.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendix.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Attendix.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconSize">@dimen/icon_size_md</item>
        <item name="iconTint">@color/on_surface</item>
    </style>

    <style name="Widget.Attendix.Button.Icon.Filled" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="iconSize">@dimen/icon_size_md</item>
    </style>

    <!-- ====================== CARD STYLES ====================== -->
    
    <style name="Widget.Attendix.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <style name="Widget.Attendix.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <style name="Widget.Attendix.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- ====================== TEXT INPUT STYLES ====================== -->
    
    <style name="Widget.Attendix.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="hintTextAppearance">@style/TextAppearance.Attendix.BodySmall</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="Widget.Attendix.TextInputLayout.Filled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="hintTextAppearance">@style/TextAppearance.Attendix.BodySmall</item>
    </style>

    <style name="Widget.Attendix.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.Attendix.BodyLarge</item>
        <item name="android:paddingTop">@dimen/input_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/input_padding_vertical</item>
    </style>

    <!-- ====================== CHIP STYLES ====================== -->
    
    <style name="Widget.Attendix.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/corner_radius_full</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendix.LabelMedium</item>
    </style>

    <style name="Widget.Attendix.Chip.Suggestion" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipCornerRadius">@dimen/corner_radius_full</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendix.LabelMedium</item>
    </style>

    <style name="Widget.Attendix.Chip.Status" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">@dimen/corner_radius_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendix.LabelSmall</item>
        <item name="chipMinHeight">24dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
    </style>

    <!-- ====================== TOOLBAR STYLES ====================== -->
    
    <style name="Widget.Attendix.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:minHeight">@dimen/toolbar_height</item>
        <item name="titleTextAppearance">@style/TextAppearance.Attendix.TitleLarge</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Attendix.BodyMedium</item>
    </style>

    <!-- ====================== BOTTOM NAVIGATION STYLES ====================== -->
    
    <style name="Widget.Attendix.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Attendix.LabelMedium</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Attendix.LabelMedium</item>
        <item name="itemIconSize">@dimen/bottom_nav_icon_size</item>
        <item name="android:minHeight">@dimen/bottom_nav_height</item>
    </style>

    <!-- ====================== FAB STYLES ====================== -->
    
    <style name="Widget.Attendix.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.Attendix.MediumComponent</item>
    </style>

    <style name="Widget.Attendix.FAB.Extended" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.Attendix.MediumComponent</item>
    </style>

    <!-- ====================== PROGRESS STYLES ====================== -->
    
    <style name="Widget.Attendix.ProgressIndicator.Circular" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorSize">@dimen/circular_progress_size</item>
        <item name="trackThickness">4dp</item>
    </style>

    <style name="Widget.Attendix.ProgressIndicator.Circular.Small" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorSize">@dimen/circular_progress_size_small</item>
        <item name="trackThickness">2dp</item>
    </style>

    <style name="Widget.Attendix.ProgressIndicator.Linear" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">@dimen/progress_bar_height</item>
        <item name="trackCornerRadius">2dp</item>
    </style>

    <!-- ====================== DIALOG STYLES ====================== -->
    
    <style name="ThemeOverlay.Attendix.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Attendix.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Attendix.Button.Text</item>
    </style>

    <!-- ====================== BOTTOM SHEET STYLES ====================== -->
    
    <style name="ThemeOverlay.Attendix.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Attendix.BottomSheet</item>
    </style>

    <style name="Widget.Attendix.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.Attendix.BottomSheet</item>
    </style>

    <!-- ====================== DIVIDER STYLES ====================== -->
    
    <style name="Widget.Attendix.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider_height</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- ====================== STATUS CHIP STYLES ====================== -->
    
    <style name="Widget.Attendix.StatusChip.Present" parent="Widget.Attendix.Chip.Status">
        <item name="chipBackgroundColor">@color/success_container</item>
        <item name="android:textColor">@color/on_success_container</item>
    </style>

    <style name="Widget.Attendix.StatusChip.Absent" parent="Widget.Attendix.Chip.Status">
        <item name="chipBackgroundColor">@color/error_container</item>
        <item name="android:textColor">@color/on_error_container</item>
    </style>

    <style name="Widget.Attendix.StatusChip.Late" parent="Widget.Attendix.Chip.Status">
        <item name="chipBackgroundColor">@color/warning_container</item>
        <item name="android:textColor">@color/on_warning_container</item>
    </style>

    <style name="Widget.Attendix.StatusChip.Pending" parent="Widget.Attendix.Chip.Status">
        <item name="chipBackgroundColor">@color/warning_container</item>
        <item name="android:textColor">@color/on_warning_container</item>
    </style>

    <style name="Widget.Attendix.StatusChip.Approved" parent="Widget.Attendix.Chip.Status">
        <item name="chipBackgroundColor">@color/success_container</item>
        <item name="android:textColor">@color/on_success_container</item>
    </style>

    <style name="Widget.Attendix.StatusChip.Rejected" parent="Widget.Attendix.Chip.Status">
        <item name="chipBackgroundColor">@color/error_container</item>
        <item name="android:textColor">@color/on_error_container</item>
    </style>

    <!-- Circle ImageView Shape Appearance -->
    <style name="ShapeAppearance.App.CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
